{
  "name": "@glxmart/conductor-mcp",
  "version": "0.1.0",
  "description": "MCP middleware for BOSS worker orchestration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "conductor-mcp": "dist/bin.js"
  },
  "files": [
    "dist",
    "worker-configs",
    "schemas",
    "README.md",
    "CHANGELOG.md",
    "INDEX.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/bin.ts stdio",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:local": "vitest run tests/e2e --reporter=verbose",
    "prepublishOnly": "pnpm run build && pnpm run test",
    "docker:build": "cd docker/boss-worker-base && ./build.sh",
    "docker:build:push": "cd docker/boss-worker-base && ./build.sh --push",
    "docker:test": "cd docker/boss-worker-base && ./build.sh --version test",
    "worker-configs:update": "cd docker && ./update-worker-configs.sh",
    "worker-configs:dry-run": "cd docker && ./update-worker-configs.sh --dry-run",
    "worker-configs:rollback": "cd docker && ./update-worker-configs.sh --rollback"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "ajv": "^8.12.0",
    "execa": "^9.6.1",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.26.0",
  "keywords": [
    "mcp",
    "boss",
    "orchestration",
    "workers",
    "container-use"
  ],
  "author": "glxmart",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/glxmart/boss.git",
    "directory": "conductor-mcp"
  },
  "homepage": "https://github.com/glxmart/boss/tree/main/conductor-mcp#readme",
  "bugs": {
    "url": "https://github.com/glxmart/boss/issues"
  }
}
