{
  "name": "@glxmart/boss-cli",
  "version": "1.3.0",
  "description": "BOSS Bootstrap CLI - Scaffold new BOSS projects with complete configuration",
  "type": "module",
  "bin": {
    "boss": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc && cp -r assets dist/",
    "prepublishOnly": "pnpm run build && pnpm run test",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.integration.config.ts tests/integration/template-e2e.test.ts tests/integration/git-hooks-e2e.test.ts",
    "test:local": "bash test-local.sh",
    "debug:spawn": "bash scripts/debug-worker-spawn.sh"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.26.0",
  "keywords": [
    "boss",
    "bootstrap",
    "cli",
    "scaffold"
  ],
  "author": "glxmart",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/glxmart/boss.git",
    "directory": "boss-cli"
  },
  "homepage": "https://github.com/glxmart/boss/tree/main/boss-cli#readme",
  "bugs": {
    "url": "https://github.com/glxmart/boss/issues"
  },
  "files": [
    "dist",
    "assets",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@glxmart/conductor-mcp": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^11.0.0",
    "execa": "^8.0.0",
    "fs-extra": "^11.1.0",
    "handlebars": "^4.7.0",
    "inquirer": "^9.2.0",
    "js-yaml": "^4.1.0",
    "ora": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/fs-extra": "^11.0.0",
    "@types/inquirer": "^9.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.18.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.0.0"
  }
}
