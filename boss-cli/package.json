{
  "name": "@boss/cli",
  "version": "1.0.0",
  "description": "BOSS Bootstrap CLI - Scaffold new BOSS projects with complete configuration",
  "type": "module",
  "bin": {
    "boss": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc && cp -r assets dist/",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:local": "bash test-local.sh"
  },
  "keywords": [
    "boss",
    "bootstrap",
    "cli",
    "scaffold"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@boss/conductor-mcp": "file:../conductor-mcp",
    "chalk": "^5.3.0",
    "commander": "^11.0.0",
    "execa": "^8.0.0",
    "fs-extra": "^11.1.0",
    "handlebars": "^4.7.0",
    "inquirer": "^9.2.0",
    "js-yaml": "^4.1.0",
    "ora": "^7.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.0",
    "@types/inquirer": "^9.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.0"
  }
}
