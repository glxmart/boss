# BOSS Worker Base Image - .dockerignore
# Exclude unnecessary files from Docker build context

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment files
.env
.env.*
!.env.example

# Git
.git/
.gitignore
.gitattributes

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test files
coverage/
*.test.ts
*.test.js
*.spec.ts
*.spec.js
__tests__/
test/
tests/

# Documentation
*.md
!README.md
docs/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Docker
Dockerfile.*
docker-compose*.yml

# Temporary files
tmp/
temp/
*.tmp
*.log
