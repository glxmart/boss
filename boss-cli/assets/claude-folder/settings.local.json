{
  "permissions": {
    "allow": [
      "Bash(test:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(echo:*)",
      "Bash(curl:*)",
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(bash scripts/security-check.sh)",
      "Bash(cat .boss/project-config.json)",
      "Bash(ls .boss/)",
      "Bash(ls -la .boss/)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git log:*)",
      "Bash(git ls-tree:*)",
      "Bash(git remote:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(rm ./*)",
      "Bash(rm -f ./*)",
      "Bash(rm ./.*)",
      "Bash(rm -f ./.*)",
      "Bash(rm ./**/*)",
      "Bash(rm -f ./**/*)",
      "Read(*)",
      "Read(**)",
      "Read(.*)",
      "Read(.*/**)",
      "Read(.boss/**)",
      "Read(.boss/project-config.json)",
      "Write(*)",
      "Write(**)",
      "Write(.*)",
      "Write(.*/**)",
      "Write(.boss/**)",
      "Write(.boss/project-config.json)",
      "Edit(*)",
      "Edit(**)",
      "Edit(.*)",
      "Edit(.*/**)",
      "Edit(.boss/**)",
      "Edit(.boss/project-config.json)",
      "Delete(*)",
      "Delete(**)"
    ],
    "ask": [
      "Bash(rm -rf ./*)"
    ],
    "deny": [
      "Bash(rm //etc/**)",
      "Bash(rm //usr/**)",
      "Bash(rm //var/**)",
      "Bash(rm //home/**)",
      "Bash(rm -f //etc/**)",
      "Bash(rm -f //usr/**)",
      "Bash(rm -f //var/**)",
      "Bash(rm -rf //etc/**)",
      "Bash(rm -rf //usr/**)",
      "Bash(rm -rf //var/**)",
      "Read(//etc/**)",
      "Read(//usr/**)",
      "Read(//var/**)",
      "Read(//root/**)",
      "Read(//tmp/**)",
      "Write(//etc/**)",
      "Write(//usr/**)",
      "Write(//var/**)",
      "Write(//root/**)",
      "Edit(//etc/**)",
      "Edit(//usr/**)",
      "Edit(//var/**)",
      "Edit(//root/**)",
      "Delete(//etc/**)",
      "Delete(//usr/**)",
      "Delete(//var/**)",
      "Delete(//root/**)"
    ]
  }
}
