{
  "$schema": "../container-config.schema.json",
  "setup_commands": [
    "apt-get update",
    "apt-get install -y docker.io kubectl"
  ],
  "environment_variables": {
    "DOCKER_BUILDKIT": "1"
  },
  "network": {
    "allowed_hosts": [
      "api.anthropic.com",
      "claude.ai",
      "registry.npmjs.org",
      "github.com",
      "hub.docker.com",
      "gcr.io",
      "quay.io",
      "docker.io",
      "k8s.io",
      "registry.k8s.io"
    ]
  }
}
