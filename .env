# BOSS Monorepo Development Environment
# These use 1Password secret references (op:// format)
# Start your IDE with: op run --env-file=.env -- code .

# GitHub Authentication
GITHUB_PERSONAL_ACCESS_TOKEN=op://boss/github/token
GITHUB_TOKEN=op://boss/github/token

# Claude Code OAuth Token (for conductor workers)
CLAUDE_CODE_OAUTH_TOKEN=op://glx/claude-code/oauth-token
