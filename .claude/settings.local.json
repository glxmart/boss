{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(op run:*)",
      "WebSearch",
      "WebFetch(domain:*)",
      "Skill",
      "mcp__github__*",
      "WebFetch(domain:github.com)"
    ],
    "deny": [
      "Bash(op read:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "git",
      "gh",
      "curl",
      "npm",
      "pnpm",
      "npx",
      "op"
    ]
  }
}
