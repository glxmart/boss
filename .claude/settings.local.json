{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["git", "gh", "curl", "npm", "pnpm", "npx", "op"]
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(op run:*)",
      "WebSearch",
      "WebFetch(domain:*)",
      "mcp__github__*",
      "Skill(*)"
    ],
    "deny": ["Bash(op read:*)"]
  }
}
