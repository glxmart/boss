{
  "base_image": "node:22-slim",
  "setup_commands": [
    "apt-get update",
    "apt-get install -y bash git curl build-essential"
  ],
  "install_commands": [
    "npm install -g @anthropic-ai/claude-code"
  ],
  "environment_variables": {
    "WORKER_ROLE": "${workerName}",
    "SPEC_KIT_MODE": "true",
    "SPEC_KIT_PATH": ".specify",
    "PATH": "$PATH:.specify/scripts",
    "CLAUDE_CONFIG_DIR": "/workdir/.boss/workers/${workerName}/.claude"
  },
  "secrets": [
    "CLAUDE_CODE_OAUTH_TOKEN=op://glx/claude-code/oauth-token"
  ],
  "network": {
    "allowed_hosts": [
      "github.com",
      "registry.npmjs.org",
      "api.anthropic.com",
      "claude.ai"
    ]
  }
}
