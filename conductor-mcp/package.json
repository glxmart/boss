{
  "name": "@boss/conductor-mcp",
  "version": "0.1.0",
  "description": "MCP middleware for BOSS worker orchestration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "conductor-mcp": "dist/bin.js"
  },
  "files": [
    "dist",
    "worker-configs",
    "README.md",
    "BOSS-GUIDE.md",
    "INSTALLATION.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/bin.ts stdio",
